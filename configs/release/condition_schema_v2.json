    {"index": 6, "name": "noise_read_b", "encoding": "(log10(b)+10)/7"},
    {"index": 7, "name": "sensor_temperature_c", "encoding": "(value+20)/120"},
    {"index": 8, "name": "scene_brightness", "encoding": "identity"},
